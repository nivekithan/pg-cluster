# Environment Variables for PostgreSQL with pgBackRest
# ===================================================
# 
# This file contains all required environment variables for the postgres-pgbackrest container.
# All variables are REQUIRED - no defaults are provided.
#
# Usage:
#   1. Copy this file: cp env.sample .env
#   2. Edit .env with your actual values
#   3. Source the file: source .env
#   4. Run the update script: ./set-postgres-secrets.sh
#
# IMPORTANT: Never commit .env files with actual secrets to version control!

# PostgreSQL Configuration
# ------------------------
# Core PostgreSQL database configuration
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_USER=postgres
POSTGRES_DB=mydb
PGDATA=/var/lib/postgresql/data

# S3 Configuration for pgBackRest
# --------------------------------
# S3-compatible storage backend for PostgreSQL backups
S3_BUCKET_NAME=your-backup-bucket-name
S3_ENDPOINT=https://s3.amazonaws.com
S3_ACCESS_KEY=AKIAIOSFODNN7EXAMPLE
S3_ACCESS_KEY_SECRET=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_REGION=us-east-1

# pgBackRest Configuration
# ------------------------
# Backup and archiving configuration for PostgreSQL
REPO1_RETENTION_FULL=7
STANZA_NAME=postgres-main
ARCHIVE_TIMEOUT=60s
MAX_WAL_SENDERS=3
WAL_KEEP_SIZE=1GB
PG1_SOCKET_PATH=/tmp/postgres

# Example Values Explanation:
# ---------------------------
# POSTGRES_PASSWORD: Strong password for PostgreSQL superuser
# POSTGRES_USER: PostgreSQL superuser username (typically 'postgres')
# POSTGRES_DB: Name of the default database to create
# PGDATA: Path where PostgreSQL stores its data files
# 
# S3_BUCKET_NAME: S3 bucket name for storing backups
# S3_ENDPOINT: S3 service endpoint URL
# S3_ACCESS_KEY: AWS/S3 access key ID
# S3_ACCESS_KEY_SECRET: AWS/S3 secret access key
# S3_REGION: AWS region where the S3 bucket is located
#
# REPO1_RETENTION_FULL: Number of full backups to retain
# STANZA_NAME: Unique identifier for this PostgreSQL instance in pgBackRest
# ARCHIVE_TIMEOUT: How long to wait before forcing a WAL archive
# MAX_WAL_SENDERS: Maximum number of WAL sender processes
# WAL_KEEP_SIZE: Amount of WAL data to retain on disk
# PG1_SOCKET_PATH: Path to PostgreSQL Unix socket directory for pgBackRest

# For production environments, consider:
# - Using strong, randomly generated passwords
# - Rotating S3 credentials regularly
# - Setting appropriate backup retention policies
# - Using dedicated S3 buckets with proper IAM policies